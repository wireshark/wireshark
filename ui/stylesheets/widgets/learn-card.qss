/* ===================================================================
 * Wireshark Welcome Page — Learn Card Widget
 *
 * Widget hierarchy:
 *   LearnCardWidget (QFrame)        — rounded card container
 *     #learnHeader                  — ClickableLabel, "Learn" title
 *     #learnHeaderSeparator         — QFrame HLine, 1px divider
 *     #learnLinkContainer           — QWidget, holds link labels
 *       #learnLink (×N)             — QLabel, rich-text link
 *     #learnButtonContainer         — QWidget, holds action buttons
 *       #learnButton (×N)           — QPushButton, colored action button
 *
 * All colors are sourced from either the Qt palette() (so they
 * adapt to the platform style) or from theme tokens resolved by
 * ThemeManager::styleSheet("widgets/learn-card").  No literal color
 * values are allowed in this file.
 * =================================================================== */


/* -----------------------------------------------------------------
 * Card container — raised surface with border, from the shared card tokens
 * ----------------------------------------------------------------- */
LearnCardWidget {
    background-color: wstheme(CardBackground);
    border: 1px solid wstheme(CardBorder);
    border-radius: 6px;
}


/* -----------------------------------------------------------------
 * Header label — "Learn"
 *
 * Colors are the shared section header colors, re-derived to read on
 * the card surface.
 * ----------------------------------------------------------------- */
QLabel#learnHeader {
    color: wstheme(CardSectionHeader);
    padding: 10px 12px;
}

QLabel#learnHeader:hover {
    color: wstheme(CardSectionHeaderHover);
}


/* -----------------------------------------------------------------
 * Header separator — 1px horizontal line (lines on the card use the
 * card border token)
 * ----------------------------------------------------------------- */
QFrame#learnHeaderSeparator {
    color: wstheme(CardBorder);
}


/* -----------------------------------------------------------------
 * Link labels — clickable rich-text links
 *
 * The anchor color is the CardLink token, set as the labels'
 * QPalette::Link in LearnCardWidget (QSS color does not reach rich-text
 * anchors).  Hover is the item hover fill on the card, moved toward the
 * card until the link reads on it.  Keyboard focus is a ring in a
 * border reserved in every state, so focusing does not
 * shift the layout; the native anchor selection is turned off so focus
 * and hover never look alike.
 *
 * Border and padding together are the label's text inset: 4px
 * vertical, 10px horizontal expanded, 4px all round when collapsed
 * (property "collapsed", set by LearnCardWidget).  Change them
 * together, or the rows grow and the capped card clips them.
 * ----------------------------------------------------------------- */
QLabel#learnLink {
    border: 2px solid transparent;
    border-radius: 4px;
    padding: 2px 8px;
    selection-background-color: transparent;
    selection-color: wstheme(CardLink);
}

QLabel#learnLink[collapsed="true"] {
    padding: 2px;
}

QLabel#learnLink:hover {
    background-color: wstheme(CardLinkHover);
}

QLabel#learnLink:focus {
    border-color: wstheme(CardFocusRing);
}


/* -----------------------------------------------------------------
 * Action buttons — colored buttons driven by JSON config
 *
 * Background and text colors are set per button in code
 * (ThemeStyler::buttonStyleSheet()), from the learn_card.json
 * configuration (a hex seed or a theme token name, darkened until the
 * white label reads).
 * ----------------------------------------------------------------- */
QPushButton#learnButton {
    border: none;
    border-radius: 6px;
    padding: 10px 12px;
    font-weight: 500;
}


/* -----------------------------------------------------------------
 * Button container — separator line above action buttons, in the card
 * border token
 * ----------------------------------------------------------------- */
QWidget#learnButtonContainer {
    border-top: 1px solid wstheme(CardBorder);
}
