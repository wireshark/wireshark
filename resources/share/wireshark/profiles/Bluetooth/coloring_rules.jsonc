// DO NOT EDIT THIS FILE!  It was created by Wireshark
[
  {
    "Bad TCP": {
      "filter": "tcp.analysis.flags && !tcp.analysis.window_update",
      "foreground": "#ff5f5f",
      "background": "#000000",
      "enabled": true
    }
  },
  {
    "HSRP State Change": {
      "filter": "hsrp.state != 8 && hsrp.state != 16",
      "foreground": "#fff600",
      "background": "#000000",
      "enabled": true
    }
  },
  {
    "Spanning Tree Topology  Change": {
      "filter": "stp.type == 0x80",
      "foreground": "#fff600",
      "background": "#000000",
      "enabled": true
    }
  },
  {
    "OSPF State Change": {
      "filter": "ospf.msg != 1",
      "foreground": "#fff600",
      "background": "#000000",
      "enabled": true
    }
  },
  {
    "ICMP errors": {
      "filter": "icmp.type eq 3 || icmp.type eq 4 || icmp.type eq 5 || icmp.type eq 11 || icmpv6.type eq 1 || icmpv6.type eq 2 || icmpv6.type eq 3 || icmpv6.type eq 4",
      "foreground": "#00ff0e",
      "background": "#000000",
      "enabled": true
    }
  },
  {
    "ARP": {
      "filter": "arp",
      "foreground": "#000000",
      "background": "#d6e8ff",
      "enabled": true
    }
  },
  {
    "ICMP": {
      "filter": "icmp || icmpv6",
      "foreground": "#000000",
      "background": "#c2c2ff",
      "enabled": true
    }
  },
  {
    "TCP RST": {
      "filter": "tcp.flags.reset eq 1",
      "foreground": "#fff680",
      "background": "#900000",
      "enabled": true
    }
  },
  {
    "SCTP ABORT": {
      "filter": "sctp.chunk_type eq ABORT",
      "foreground": "#fff680",
      "background": "#900000",
      "enabled": true
    }
  },
  {
    "IPv4 TTL low or unexpected": {
      "filter": "(ip.dst != 224.0.0.0/4 && ip.ttl < 5 && !(pim || ospf || eigrp || bgp || tcp.port==179)) || (ip.dst == 224.0.0.0/24 && ip.dst != 224.0.0.251 && ip.ttl != 1 && !(vrrp || carp || eigrp || rip || glbp))",
      "foreground": "#ecf0eb",
      "background": "#a40000",
      "enabled": true
    }
  },
  {
    "IPv6 hop limit low or unexpected": {
      "filter": "(ipv6.dst != ff00::/8 && ipv6.hlim < 5 && !( ospf|| bgp || tcp.port==179)) || (ipv6.dst==ff00::/8 && ipv6.hlim not in {1, 64, 255})",
      "foreground": "#ecf0eb",
      "background": "#a40000",
      "enabled": true
    }
  },
  {
    "Checksum Errors": {
      "filter": "cdp.checksum.status==\"Bad\" || edp.checksum.status==\"Bad\" || ip.checksum.status==\"Bad\" || tcp.checksum.status==\"Bad\" || udp.checksum.status==\"Bad\"|| sctp.checksum.status==\"Bad\" || mstp.checksum.status==\"Bad\"",
      "foreground": "#ff5f5f",
      "background": "#000000",
      "enabled": true
    }
  },
  {
    "SMB": {
      "filter": "smb || nbss || nbns || nbipx || ipxsap || netbios",
      "foreground": "#000000",
      "background": "#fffa99",
      "enabled": true
    }
  },
  {
    "HTTP": {
      "filter": "http || tcp.port == 80",
      "foreground": "#000000",
      "background": "#8dff7f",
      "enabled": true
    }
  },
  {
    "IPX": {
      "filter": "ipx || spx",
      "foreground": "#000000",
      "background": "#ffe3e5",
      "enabled": true
    }
  },
  {
    "DCERPC": {
      "filter": "dcerpc",
      "foreground": "#000000",
      "background": "#c797ff",
      "enabled": true
    }
  },
  {
    "Routing": {
      "filter": "hsrp || eigrp || ospf || bgp || cdp || vrrp || carp || gvrp || igmp || ismp",
      "foreground": "#000000",
      "background": "#fff3d6",
      "enabled": true
    }
  },
  {
    "TCP SYN/FIN": {
      "filter": "tcp.flags & 0x02 || tcp.flags.fin == 1",
      "foreground": "#000000",
      "background": "#a0a0a0",
      "enabled": true
    }
  },
  {
    "TCP": {
      "filter": "tcp",
      "foreground": "#000000",
      "background": "#e7e6ff",
      "enabled": true
    }
  },
