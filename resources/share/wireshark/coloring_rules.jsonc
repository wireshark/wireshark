// DO NOT EDIT THIS FILE!  It was created by Wireshark
[
  {
    "Bad TCP": {
      "filter": "tcp.analysis.flags && !tcp.analysis.window_update && !tcp.analysis.keep_alive && !tcp.analysis.keep_alive_ack",
      "foreground": "#f78787",
      "background": "#12272e",
      "enabled": true
    }
  },
  {
    "HSRP State Change": {
      "filter": "hsrp.state != 8 && hsrp.state != 16",
      "foreground": "#fffc9c",
      "background": "#12272e",
      "enabled": true
    }
  },
  {
    "Spanning Tree Topology  Change": {
      "filter": "stp.type == 0x80",
      "foreground": "#fffc9c",
      "background": "#12272e",
      "enabled": true
    }
  },
  {
    "OSPF State Change": {
      "filter": "ospf.msg != 1",
      "foreground": "#fffc9c",
      "background": "#12272e",
      "enabled": true
    }
  },
  {
    "ICMP errors": {
      "filter": "icmp.type in { 3..5, 11 } || icmpv6.type in { 1..4 }",
      "foreground": "#b7f774",
      "background": "#12272e",
      "enabled": true
    }
  },
  {
    "ARP": {
      "filter": "arp",
      "foreground": "#12272e",
      "background": "#faf0d7",
      "enabled": true
    }
  },
  {
    "ICMP": {
      "filter": "icmp || icmpv6",
      "foreground": "#12272e",
      "background": "#fce0ff",
      "enabled": true
    }
  },
  {
    "TCP RST": {
      "filter": "tcp.flags.reset eq 1",
      "foreground": "#fffc9c",
      "background": "#a40000",
      "enabled": true
    }
  },
  {
    "SCTP ABORT": {
      "filter": "sctp.chunk_type eq ABORT",
      "foreground": "#fffc9c",
      "background": "#a40000",
      "enabled": true
    }
  },
  {
    "IPv4 TTL low or unexpected": {
      "filter": "(ip.dst != 224.0.0.0/4 && ip.ttl < 5 && !(pim || ospf || eigrp || bgp || tcp.port==179)) || (ip.dst == 224.0.0.0/24 && ip.dst != 224.0.0.251 && ip.ttl != 1 && !(vrrp || carp || eigrp || rip || glbp))",
      "foreground": "#ecf0eb",
      "background": "#a40000",
      "enabled": true
    }
  },
  {
    "IPv6 hop limit low or unexpected": {
      "filter": "(ipv6.dst != ff00::/8 && ipv6.hlim < 5 && !( ospf|| bgp || tcp.port==179)) || (ipv6.dst==ff00::/8 && ipv6.hlim not in {1, 64, 255})",
      "foreground": "#ecf0eb",
      "background": "#a40000",
      "enabled": true
    }
  },
  {
    "Checksum Errors": {
      "filter": "eth.fcs.status==\"Bad\" || ip.checksum.status==\"Bad\" || tcp.checksum.status==\"Bad\" || udp.checksum.status==\"Bad\" || sctp.checksum.status==\"Bad\" || mstp.checksum.status==\"Bad\" || cdp.checksum.status==\"Bad\" || edp.checksum.status==\"Bad\" || wlan.fcs.status==\"Bad\" || stt.checksum.status==\"Bad\"",
      "foreground": "#f78787",
      "background": "#12272e",
      "enabled": true
    }
  },
  {
    "SMB": {
      "filter": "smb || nbss || nbns || netbios",
      "foreground": "#12272e",
      "background": "#feffd0",
      "enabled": true
    }
  },
  {
    "HTTP": {
      "filter": "http || tcp.port == 80 || http2 || http3",
      "foreground": "#12272e",
      "background": "#e4ffc7",
      "enabled": true
    }
  },
  {
    "DCERPC": {
      "filter": "dcerpc",
      "foreground": "#12272e",
      "background": "#c797ff",
      "enabled": true
    }
  },
  {
    "Routing": {
      "filter": "hsrp || eigrp || ospf || bgp || cdp || vrrp || carp || gvrp || igmp || ismp",
      "foreground": "#12272e",
      "background": "#fff3d6",
      "enabled": true
    }
  },
  {
    "TCP SYN/FIN": {
      "filter": "tcp.flags & 0x02 || tcp.flags.fin == 1",
      "foreground": "#12272e",
      "background": "#a0a0a0",
      "enabled": true
    }
  },
  {
    "TCP": {
      "filter": "tcp",
      "foreground": "#12272e",
      "background": "#e7e6ff",
      "enabled": true
    }
  },
  {
    "UDP": {
      "filter": "udp",
      "foreground": "#12272e",
      "background": "#daeeff",
      "enabled": true
    }
  },
  {
    "Broadcast": {
      "filter": "eth[0] & 1",
      "foreground": "#babdb6",
      "background": "#ffffff",
      "enabled": true
    }
  }
]
