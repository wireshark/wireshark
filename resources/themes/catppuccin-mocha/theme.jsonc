// =====================================================================
// Wireshark Catppuccin Mocha Theme
// =====================================================================
//
// Colors from Catppuccin (MIT license, (c) 2021 Catppuccin),
// https://github.com/catppuccin/catppuccin, following its style guide.
// Light mode is Latte, the only light flavor, so the three Catppuccin
// themes share their light side; dark mode is Mocha.  Only the
// color values are taken over.
//
// Format: JSONC: standard JSON with C-style comments.
// =====================================================================

{
	"meta": {
		"name": "Catppuccin Mocha",
		"version": 1,
		"author": "Wireshark Foundation",
		"description": "Colors from Catppuccin Mocha and Latte (MIT)."
	},

	// -----------------------------------------------------------------
	// Brand: Mauve, the usual Catppuccin accent.
	// -----------------------------------------------------------------
	"brand": {
		"primary": { "light": "#8839ef", "dark": "#cba6f7" }
	},

	// -----------------------------------------------------------------
	// Accent: Green, Yellow, Red and Blue, the style guide colors for
	// success, warnings, errors and links.  The filter field tints
	// (valid, invalid, deprecated) derive from these; the theme does
	// not pin them.
	// -----------------------------------------------------------------
	"accent": {
		"success": { "light": "#40a02b", "dark": "#a6e3a1" },
		"warning": { "light": "#df8e1d", "dark": "#f9e2af" },
		"error":   { "light": "#d20f39", "dark": "#f38ba8" },
		"info":    { "light": "#1e66f5", "dark": "#89b4fa" }
	},

	// -----------------------------------------------------------------
	// Expert info fills: each severity color laid over palette.base,
	// with one foreground that reads on all five fills.
	// -----------------------------------------------------------------
	"expert": {
		"comment":    { "light": "#c3ddc2", "dark": "#475950" },
		"chat":       { "light": "#bbcef5", "dark": "#3e4b6b" },
		"note":       { "light": "#b9d9de", "dark": "#415960" },
		"warn":       { "light": "#ebd8bf", "dark": "#605955" },
		"error":      { "light": "#e8b8c6", "dark": "#5e3f53" },
		"foreground": { "light": "#4c4f69", "dark": "#cdd6f4" }
	},

	// -----------------------------------------------------------------
	// Packets: the style guide selection, Overlay 2 at 25 % over
	// Base (15 % for the inactive selection), written as opaque
	// colors; marked rows in Mauve with Base text (text on accents).
	// -----------------------------------------------------------------
	"packets": {
		"selection":     { "light": "#d2d4dc", "dark": "#3b3d4f" },
		"selectionText": { "light": "#4c4f69", "dark": "#cdd6f4" },
		"inactive":      { "light": "#dee0e6", "dark": "#303042" },
		"inactiveText":  { "light": "#4c4f69", "dark": "#cdd6f4" },
		"marked":        { "light": "#8839ef", "dark": "#cba6f7" },
		"markedText":    { "light": "#eff1f5", "dark": "#1e1e2e" }
	},

	// -----------------------------------------------------------------
	// Follow Stream: a red-tinted client and a blue-tinted server,
	// each text color lifted until it reads on its fill.
	// -----------------------------------------------------------------
	"conversation": {
		"client":     { "light": "#ecd6de", "dark": "#3e2e40" },
		"clientText": { "light": "#c10e35", "dark": "#f38ba8" },
		"server":     { "light": "#d6e0f5", "dark": "#2e344d" },
		"serverText": { "light": "#1b5ad9", "dark": "#89b4fa" }
	},

	// -----------------------------------------------------------------
	// Filter: the saved-filter bookmark glyph in Yellow, the history
	// arrow in Overlay 2.
	// -----------------------------------------------------------------
	"filter": {
		"bookmarkMatch": { "light": "#df8e1d", "dark": "#f9e2af" },
		"history":       { "light": "#7c7f93", "dark": "#9399b2" }
	},

	// -----------------------------------------------------------------
	// Palette: light = Latte, dark = Mocha.  Base background,
	// Mantle window and alternate rows, Text for all text, Overlay 1
	// as the secondary tone, Surface 0 for quiet borders.
	// -----------------------------------------------------------------
	"palette": {
		"window":          { "light": "#e6e9ef", "dark": "#181825" },
		"windowText":      { "light": "#4c4f69", "dark": "#cdd6f4" },
		"base":            { "light": "#eff1f5", "dark": "#1e1e2e" },
		"text":            { "light": "#4c4f69", "dark": "#cdd6f4" },
		"alternateBase":   { "light": "#e6e9ef", "dark": "#181825" },
		"mid":             { "light": "#8c8fa1", "dark": "#7f849c" },
		"midlight":        { "light": "#ccd0da", "dark": "#313244" }
	},

	// -----------------------------------------------------------------
	// Graph colors: thirteen accent colors and Overlay 2, in the same
	// order in light (Latte) and dark mode.
	// -----------------------------------------------------------------
	"graphs": [
		{ "light": "#1e66f5", "dark": "#89b4fa" },
		{ "light": "#d20f39", "dark": "#f38ba8" },
		{ "light": "#40a02b", "dark": "#a6e3a1" },
		{ "light": "#df8e1d", "dark": "#f9e2af" },
		{ "light": "#8839ef", "dark": "#cba6f7" },
		{ "light": "#179299", "dark": "#94e2d5" },
		{ "light": "#fe640b", "dark": "#fab387" },
		{ "light": "#ea76cb", "dark": "#f5c2e7" },
		{ "light": "#04a5e5", "dark": "#89dceb" },
		{ "light": "#e64553", "dark": "#eba0ac" },
		{ "light": "#7287fd", "dark": "#b4befe" },
		{ "light": "#209fb5", "dark": "#74c7ec" },
		{ "light": "#dd7878", "dark": "#f2cdcd" },
		{ "light": "#7c7f93", "dark": "#9399b2" }
	]
}
