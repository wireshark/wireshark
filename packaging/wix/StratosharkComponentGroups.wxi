<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Stratoshark -->
    <Fragment>
      <DirectoryRef Id="INSTALLFOLDER">
        <Component Id="cmpStratoshark_exe">
          <File Id="filStratoshark_exe" KeyPath="yes" Source="$(var.Staging.Dir)\Stratoshark.exe" />
        </Component>
      </DirectoryRef>
    </Fragment>
    <Fragment>
      <ComponentGroup Id="CG.Stratoshark">
        <ComponentRef Id="cmpStratoshark_exe" />
      </ComponentGroup>
    </Fragment>

  <!-- Strato -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="cmpStrato_exe">
        <File Id="filStrato_exe" KeyPath="yes" Source="$(var.Staging.Dir)\strato.exe" />
      </Component>
      <Component Id="cmpStrato_html">
        <File Id="filStrato_html" KeyPath="yes" Source="$(var.Staging.Dir)\strato.html" />
      </Component>
    </DirectoryRef>
  </Fragment>
  <Fragment>
    <ComponentGroup Id="CG.Strato">
      <ComponentRef Id="cmpStrato_exe" />
      <ComponentRef Id="cmpStrato_html" />
    </ComponentGroup>
  </Fragment>

  <!-- Install for every user -->
    <Fragment>
      <DirectoryRef Id="INSTALLFOLDER">
        <Component Id="cmpWiretap_dll">
          <File Id="filWiretap_dll" KeyPath="yes" Source="$(var.Staging.Dir)\libwiretap.dll" />
        </Component>
        <Component Id="cmpLibwireshark_dll">
          <File Id="filLibwireshark_dll" KeyPath="yes" Source="$(var.Staging.Dir)\libwireshark.dll" />
        </Component>
        <Component Id="cmpLibwsutil_dll">
          <File Id="filLibwsutil_dll" KeyPath="yes" Source="$(var.Staging.Dir)\libwsutil.dll" />
        </Component>
        <Component Id="cmpLibuiqt_plugin_dll">
          <File Id="filLibuiqt_plugin_dll" KeyPath="yes" Source="$(var.Staging.Dir)\libuiqt_plugin.dll" />
        </Component>
        <Component Id="cmpCOPYING_txt">
          <File Id="filCOPYING_txt" KeyPath="yes" Source="$(var.Staging.Dir)\COPYING.txt" />
        </Component>
        <Component Id="cmpREADME_txt">
          <File Id="filREADME_txt" KeyPath="yes" Source="$(var.Staging.Dir)\README.txt" />
        </Component>
        <Component Id="cmpWka">
          <File Id="filWka" KeyPath="yes" Source="$(var.Staging.Datafile.Dir)\wka" />
        </Component>
        <Component Id="cmpPdml2html_xsl">
          <File Id="filPdml2html_xsl" KeyPath="yes" Source="$(var.Staging.Dir)\pdml2html.xsl" />
        </Component>
        <Component Id="cmpWs_css">
          <File Id="filWs_css" KeyPath="yes" Source="$(var.Staging.Dir)\ws.css" />
        </Component>
        <Component Id="cmpStratoshark_html">
          <File Id="filStratoshark_html" KeyPath="yes" Source="$(var.Staging.Dir)\stratoshark.html" />
        </Component>
        <Component Id="cmpWireshark_filter_html">
          <File Id="filWireshark_filter_html" KeyPath="yes" Source="$(var.Staging.Dir)\wireshark-filter.html" />
        </Component>
        <Component Id="cmpDumpcap_exe">
          <File Id="filDumpcap_exe" KeyPath="yes" Source="$(var.Staging.Dir)\dumpcap.exe" />
        </Component>
        <Component Id="cmpDumpcap_html">
          <File Id="filDumpcap_html" KeyPath="yes" Source="$(var.Staging.Dir)\dumpcap.html" />
        </Component>
        <Component Id="cmpExtcap_html">
          <File Id="filExtcap_html" KeyPath="yes" Source="$(var.Staging.Dir)\extcap.html" />
        </Component>
        <Component Id="cmpIpmap_html">
          <File Id="filIpmap_html" KeyPath="yes" Source="$(var.Staging.Datafile.Dir)\ipmap.html" />
        </Component>
        <Component Id="cmpReleaseNotes_html">
          <File Id="filReleaseNotes_html" KeyPath="yes" Source="$(var.Staging.Dir)\Stratoshark Release Notes.html" />
        </Component>
      </DirectoryRef>
    </Fragment>
    <Fragment>
      <ComponentGroup Id="CG.StratosharkRequired">
        <ComponentRef Id="cmpWiretap_dll" />
        <ComponentRef Id="cmpLibwireshark_dll" />
        <ComponentRef Id="cmpLibwsutil_dll" />
        <ComponentRef Id="cmpLibuiqt_plugin_dll" />
        <ComponentRef Id="cmpCOPYING_txt" />
        <ComponentRef Id="cmpREADME_txt" />
        <ComponentRef Id="cmpWka" />
        <ComponentRef Id="cmpPdml2html_xsl" />
        <ComponentRef Id="cmpWs_css" />
        <ComponentRef Id="cmpStratoshark_html" />
        <ComponentRef Id="cmpWireshark_filter_html" />
        <ComponentRef Id="cmpDumpcap_exe" />
        <ComponentRef Id="cmpDumpcap_html" />
        <ComponentRef Id="cmpExtcap_html" />
        <ComponentRef Id="cmpIpmap_html" />
        <ComponentRef Id="cmpReleaseNotes_html" />
        <ComponentRef Id="cmpQuietUninstallString" />
      </ComponentGroup>
    </Fragment>

  <!-- Windows Installer writes UninstallString under Uninstall\[ProductCode].
       Add QuietUninstallString next to it so that "msiexec" isn't required to
       be typed by hand when scripting an uninstall. -->
    <Fragment>
      <DirectoryRef Id="INSTALLFOLDER">
        <Component Id="cmpQuietUninstallString">
          <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\[ProductCode]" Name="QuietUninstallString" Type="string" Value="MsiExec.exe /X[ProductCode] /qn /norestart" KeyPath="yes" />
        </Component>
      </DirectoryRef>
    </Fragment>


  <!-- global config files By design these shouldn't be overwritten if they already exist -->
    <Fragment>
      <DirectoryRef Id="INSTALLFOLDER">
        <Component Id="cmpColoringRules">
          <File Id="filColoringRules" KeyPath="yes" Source="$(var.Staging.Datafile.Dir)\coloring_rules.jsonc" />
        </Component>
        <Component Id="cmpDfilterButtons">
          <File Id="filDfilterButtons" KeyPath="yes" Source="$(var.Staging.Datafile.Dir)\dfilter_buttons" />
        </Component>
        <Component Id="cmpSmi_modules">
          <File Id="filSmi_modules" KeyPath="yes" Source="$(var.Staging.Datafile.Dir)\smi_modules" />
        </Component>
      </DirectoryRef>
    </Fragment>
    <Fragment>
      <ComponentGroup Id="CG.ColoringRules">
        <ComponentRef Id="cmpColoringRules" />
        <ComponentRef Id="cmpDfilterButtons" />
        <ComponentRef Id="cmpSmi_modules" />
      </ComponentGroup>
    </Fragment>

  <!-- Dynamically harvested files -->
  <Fragment>
    <!-- Diameter XML dictionary files -->
    <ComponentGroup Id="CG.Diameter" Directory="dirDiameter">
      <Files Include="$(var.DiameterDir)\**" />
    </ComponentGroup>
    <!-- Qt translation files -->
    <ComponentGroup Id="CG.QtTranslations" Directory="dirTranslations">
      <Files Include="$(var.QtTranslationDir)\**" />
    </ComponentGroup>
    <!-- RADIUS dictionary files -->
    <ComponentGroup Id="CG.RadiusDict" Directory="dirRadius">
      <Files Include="$(var.RadiusDictDir)\**" />
    </ComponentGroup>
    <!-- MIBs -->
    <ComponentGroup Id="CG.Plugins.SNMP" Directory="dirSnmpMibs">
      <Files Include="$(var.SnmpMibDir)\**" />
    </ComponentGroup>
    <!-- Configuration profiles. The top-level dfilter_buttons file isn't
         part of a profile. -->
    <ComponentGroup Id="CG.Plugins.ConfigurationProfiles" Directory="dirProfiles">
      <Files Include="$(var.Stratoshark.Profiles.Dir)\**">
        <Exclude Files="$(var.Stratoshark.Profiles.Dir)\dfilter_buttons" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <!-- dtds -->
    <Fragment>
      <DirectoryRef Id="dirDtds">
        <Component Id="cmpDc_dtd">
          <File Id="filDc_dtd" KeyPath="yes" Source="$(var.Dtds.Dir)\dc.dtd" />
        </Component>
        <Component Id="cmpItunes_dtd">
          <File Id="filItunes_dtd" KeyPath="yes" Source="$(var.Dtds.Dir)\itunes.dtd" />
        </Component>
        <Component Id="cmpMscml_dtd">
          <File Id="filMscml_dtd" KeyPath="yes" Source="$(var.Dtds.Dir)\mscml.dtd" />
        </Component>
        <Component Id="cmpPocsettings_dtd">
          <File Id="filPocsettings_dtd" KeyPath="yes" Source="$(var.Dtds.Dir)\pocsettings.dtd" />
        </Component>
        <Component Id="cmpPresence_dtd">
          <File Id="filPresence_dtd" KeyPath="yes" Source="$(var.Dtds.Dir)\presence.dtd" />
        </Component>
        <Component Id="cmpReginfo_dtd">
          <File Id="filReginfo_dtd" KeyPath="yes" Source="$(var.Dtds.Dir)\reginfo.dtd" />
        </Component>
        <Component Id="cmpRlmi_dtd">
          <File Id="filRlmi_dtd" KeyPath="yes" Source="$(var.Dtds.Dir)\rlmi.dtd" />
        </Component>
        <Component Id="cmpRss_dtd">
          <File Id="filRss_dtd" KeyPath="yes" Source="$(var.Dtds.Dir)\rss.dtd" />
        </Component>
        <Component Id="cmpSmil_dtd">
          <File Id="filSmil_dtd" KeyPath="yes" Source="$(var.Dtds.Dir)\smil.dtd" />
        </Component>
        <Component Id="cmpXcap_caps_dtd">
          <File Id="filXcap_caps_dtd" KeyPath="yes" Source="$(var.Dtds.Dir)\xcap-caps.dtd" />
        </Component>
        <Component Id="cmpXcap_error_dtd">
          <File Id="filXcap_error_dtd" KeyPath="yes" Source="$(var.Dtds.Dir)\xcap-error.dtd" />
        </Component>
        <Component Id="cmpWatcherinfo_dtd">
          <File Id="filWatcherinfo_dtd" KeyPath="yes" Source="$(var.Dtds.Dir)\watcherinfo.dtd" />
        </Component>
      </DirectoryRef>
    </Fragment>
    <Fragment>
      <ComponentGroup Id="CG.Dtds">
        <ComponentRef Id="cmpDc_dtd" />
        <ComponentRef Id="cmpItunes_dtd" />
        <ComponentRef Id="cmpMscml_dtd" />
        <ComponentRef Id="cmpPocsettings_dtd" />
        <ComponentRef Id="cmpPresence_dtd" />
        <ComponentRef Id="cmpReginfo_dtd" />
        <ComponentRef Id="cmpRlmi_dtd" />
        <ComponentRef Id="cmpRss_dtd" />
        <ComponentRef Id="cmpSmil_dtd" />
        <ComponentRef Id="cmpXcap_caps_dtd" />
        <ComponentRef Id="cmpXcap_error_dtd" />
        <ComponentRef Id="cmpWatcherinfo_dtd" />
      </ComponentGroup>
    </Fragment>

  <!-- TPNCP DAT file -->
    <Fragment>
        <DirectoryRef Id="dirTpncp">
            <Component Id="cmpTpncp_dat">
                <File Id="filTpncp_dat" KeyPath="yes" Source="$(var.Tpncp.Dir)\tpncp.dat" />
            </Component>
        </DirectoryRef>
    </Fragment>
    <Fragment>
        <ComponentGroup Id="CG.Tpncp">
            <ComponentRef Id="cmpTpncp_dat" />
        </ComponentGroup>
    </Fragment>

  <!-- protobuf TLV definitions -->
    <Fragment>
      <DirectoryRef Id="dirProtobuf">
        <Component Id="cmpProtobuf_sparkplug_b_proto">
          <File Id="filProtobuf_sparkplug_b_proto" KeyPath="yes" Source="$(var.Protobuf.Dir)\sparkplug_b.proto" />
        </Component>
        <Component Id="cmpProtobuf_mysqlx_main">
          <File Id="filProtobuf_mysqlx" KeyPath="yes" Source="$(var.Protobuf.Dir)\mysqlx.proto" />
        </Component>
        <Component Id="cmpProtobuf_mysqlx_connection">
          <File Id="filProtobuf_mysqlx_connection" KeyPath="yes" Source="$(var.Protobuf.Dir)\mysqlx_connection.proto" />
        </Component>
        <Component Id="cmpProtobuf_mysqlx_crud">
          <File Id="filProtobuf_mysqlx_crud" KeyPath="yes" Source="$(var.Protobuf.Dir)\mysqlx_crud.proto" />
        </Component>
        <Component Id="cmpProtobuf_mysqlx_cursor">
          <File Id="filProtobuf_mysqlx_cursor" KeyPath="yes" Source="$(var.Protobuf.Dir)\mysqlx_cursor.proto" />
        </Component>
        <Component Id="cmpProtobuf_mysqlx_datatypes">
          <File Id="filProtobuf_mysqlx_datatypes" KeyPath="yes" Source="$(var.Protobuf.Dir)\mysqlx_datatypes.proto" />
        </Component>
        <Component Id="cmpProtobuf_mysqlx_expect">
          <File Id="filProtobuf_mysqlx_expect" KeyPath="yes" Source="$(var.Protobuf.Dir)\mysqlx_expect.proto" />
        </Component>
        <Component Id="cmpProtobuf_mysqlx_expr">
          <File Id="filProtobuf_mysqlx_expr" KeyPath="yes" Source="$(var.Protobuf.Dir)\mysqlx_expr.proto" />
        </Component>
        <Component Id="cmpProtobuf_mysqlx_notice">
          <File Id="filProtobuf_mysqlx_notice" KeyPath="yes" Source="$(var.Protobuf.Dir)\mysqlx_notice.proto" />
        </Component>
        <Component Id="cmpProtobuf_mysqlx_prepare">
          <File Id="filProtobuf_mysqlx_prepare" KeyPath="yes" Source="$(var.Protobuf.Dir)\mysqlx_prepare.proto" />
        </Component>
        <Component Id="cmpProtobuf_mysqlx_resultset">
          <File Id="filProtobuf_mysqlx_resultset" KeyPath="yes" Source="$(var.Protobuf.Dir)\mysqlx_resultset.proto" />
        </Component>
        <Component Id="cmpProtobuf_mysqlx_session">
          <File Id="filProtobuf_mysqlx_session" KeyPath="yes" Source="$(var.Protobuf.Dir)\mysqlx_session.proto" />
        </Component>
        <Component Id="cmpProtobuf_mysqlx_sql">
          <File Id="filProtobuf_mysqlx_sql" KeyPath="yes" Source="$(var.Protobuf.Dir)\mysqlx_sql.proto" />
        </Component>
      </DirectoryRef>
    </Fragment>
    <Fragment>
      <ComponentGroup Id="CG.Protobuf">
        <ComponentRef Id="cmpProtobuf_sparkplug_b_proto" />
        <ComponentRef Id="cmpProtobuf_mysqlx_main" />
        <ComponentRef Id="cmpProtobuf_mysqlx_connection" />
        <ComponentRef Id="cmpProtobuf_mysqlx_crud" />
        <ComponentRef Id="cmpProtobuf_mysqlx_cursor" />
        <ComponentRef Id="cmpProtobuf_mysqlx_datatypes" />
        <ComponentRef Id="cmpProtobuf_mysqlx_expect" />
        <ComponentRef Id="cmpProtobuf_mysqlx_expr" />
        <ComponentRef Id="cmpProtobuf_mysqlx_notice" />
        <ComponentRef Id="cmpProtobuf_mysqlx_prepare" />
        <ComponentRef Id="cmpProtobuf_mysqlx_resultset" />
        <ComponentRef Id="cmpProtobuf_mysqlx_session" />
        <ComponentRef Id="cmpProtobuf_mysqlx_sql" />
      </ComponentGroup>
    </Fragment>

  <!-- Editcap -->
  <Fragment>
      <DirectoryRef Id="INSTALLFOLDER">
          <Component Id="cmpEditcap_exe">
              <File Id="filEditcap_exe" KeyPath="yes" Source="$(var.Staging.Dir)\editcap.exe" />
