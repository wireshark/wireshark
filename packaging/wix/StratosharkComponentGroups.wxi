    </ComponentGroup>
  </Fragment>

  <!-- Sharkd -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="cmpSharkd_exe">
        <File Id="filSharkd_exe" KeyPath="yes" Source="$(var.Staging.Dir)\sharkd.exe" />
      </Component>
      <Component Id="cmpSharkd_html">
        <File Id="filSharkd_html" KeyPath="yes" Source="$(var.Staging.Dir)\sharkd.html" />
      </Component>
    </DirectoryRef>
  </Fragment>
  <Fragment>
    <ComponentGroup Id="CG.Tools.Sharkd">
      <ComponentRef Id="cmpSharkd_exe" />
      <ComponentRef Id="cmpSharkd_html" />
    </ComponentGroup>
  </Fragment>

  <!-- MMDBResolve -->
  <?ifdef MMDBRESOLVE_EXE?>
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="cmpMmdbresolve_exe">
        <File Id="filMmdbresolve_exe" KeyPath="yes" Source="$(var.Staging.Dir)\mmdbresolve.exe" />
      </Component>
      <Component Id="cmpMmdbresolve_html">
        <File Id="filMmdbresolve_html" KeyPath="yes" Source="$(var.Staging.Dir)\mmdbresolve.html" />
      </Component>
    </DirectoryRef>
  </Fragment>
  <Fragment>
    <ComponentGroup Id="CG.Tools.MMDBResolve">
      <ComponentRef Id="cmpMmdbresolve_exe" />
      <ComponentRef Id="cmpMmdbresolve_html" />
    </ComponentGroup>
  </Fragment>
  <?endif?>

  <!-- Falcodump -->
  <Fragment>
    <DirectoryRef Id="dirExtcap">
      <Component Id="cmpFalcodump_exe">
        <File Id="filFalcodump_exe" KeyPath="yes" Source="$(var.Stratoshark.Extcap.Dir)\falcodump.exe" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="cmpFalcodump_html">
        <File Id="filFalcodump_html" KeyPath="yes" Source="$(var.Staging.Dir)\falcodump.html" />
      </Component>
    </DirectoryRef>
  </Fragment>
  <Fragment>
    <ComponentGroup Id="CG.Extcap.Falcodump">
      <ComponentRef Id="cmpFalcodump_exe" />
      <ComponentRef Id="cmpFalcodump_html" />
    </ComponentGroup>
  </Fragment>

  <!-- Sshdig -->
  <?ifdef LIBSSH_FOUND?>
  <Fragment>
    <DirectoryRef Id="dirExtcap">
      <Component Id="cmpSshdig_exe">
        <File Id="filSshdig_exe" KeyPath="yes" Source="$(var.Stratoshark.Extcap.Dir)\sshdig.exe" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="cmpSshdig_html">
        <File Id="filSshdig_html" KeyPath="yes" Source="$(var.Staging.Dir)\sshdig.html" />
      </Component>
    </DirectoryRef>
  </Fragment>
  <Fragment>
    <ComponentGroup Id="CG.Extcap.Sshdig">
      <ComponentRef Id="cmpSshdig_exe" />
      <ComponentRef Id="cmpSshdig_html" />
    </ComponentGroup>
  </Fragment>
  <?endif?>

  <!-- Shortcuts -->
  <Fragment>
    <ComponentGroup Id="CG.StratosharkStartMenu" Directory="ProgramMenuFolder">
      <Component Id="cmpStratosharkShortcut" Condition="STRATOSHARK_START_MENU = &quot;1&quot;">
        <Shortcut Id="scStratoshark" Name="$(var.StratosharkName)" Description="The $(var.StratosharkName) System Call and Log Analyzer" Target="[#filStratoshark_exe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\$(var.StratosharkName)" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <ComponentGroup Id="CG.StratosharkDesktopIcon" Directory="DesktopFolder">
      <Component Id="cmpStratosharkDesktopIcon" Condition="STRATOSHARK_DESKTOP_ICON = &quot;1&quot;">
        <Shortcut Id="scStratosharkDesktop" Name="$(var.StratosharkName)" Description="The $(var.StratosharkName) System Call and Log Analyzer" Target="[#filStratoshark_exe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\$(var.StratosharkName)" Name="DesktopIcon" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- File Associations -->
  <Fragment>
    <!-- The capture file icon is the second icon (index 1) in the executable. -->
    <ComponentGroup Id="CG.StratosharkFileAssociations" Directory="INSTALLFOLDER">
      <Component Id="cmpFAscap" Condition="STRATOSHARK_FILE_EXTENSIONS = &quot;1&quot;">
        <ProgId Id="$(var.StratosharkFileAssociation)" Icon="filStratoshark_exe" IconIndex="1" Description="Stratoshark log file">
          <Extension Id="scap">
            <Verb Id="open" Command="open" TargetFile="filStratoshark_exe" Argument='"%1"' />
          </Extension>
        </ProgId>
        <RegistryValue Root="HKCU" Key="Software\$(var.StratosharkName)" Name="scap" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- libgcrypt dummy configuration directory -->
  <Fragment>
    <ComponentGroup Id="CG.gcrypt">
      <ComponentRef Id="gpg4win_etc_gcrypt" />
    </ComponentGroup>
  </Fragment>

</Include>
