      <ComponentRef Id="cmpEtwdump_html" />
    </ComponentGroup>
  </Fragment>

  <!-- Remote dumps -->
  <Fragment>
    <DirectoryRef Id="dirExtcap">
      <Component Id="cmpSshdump_exe">
        <File Id="filSshdump_exe" KeyPath="yes" Source="$(var.WiresharkExtcap.Dir)\sshdump.exe" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="cmpSshdump_html">
        <File Id="filSshdump_html" KeyPath="yes" Source="$(var.Staging.Dir)\sshdump.html" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="dirExtcap">
      <Component Id="cmpCiscodump_exe">
