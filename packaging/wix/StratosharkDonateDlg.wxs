<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI>
      <Dialog Id="StratosharkDonateDlg" Width="370" Height="270" Title="!(loc.LicenseAgreementDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.LicenseAgreementDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="14" Y="7" Width="350" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Your donations keep these releases coming" />
        <Control Id="Description" Type="Text" X="20" Y="26" Width="350" Height="15" Transparent="yes" NoPrefix="yes" Text="Donate today!" />

        <Control Id="Body" Type="Text" X="20" Y="60" Width="330" Height="40" Transparent="yes" NoPrefix="yes" Text="The Wireshark Foundation wants to help as many people as possible understand their systems and networks as much as possible. Your donation helps to support Stratoshark and Wireshark." />
        <Control Id="LearnMore" Type="Hyperlink" X="20" Y="110" Width="330" Height="11">
          <Text Value="You can learn more and donate at &lt;a href=&quot;https://wiresharkfoundation.org/&quot;&gt;https://wiresharkfoundation.org&lt;/a&gt;." />
        </Control>

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
