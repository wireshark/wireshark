<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?if $(var.Platform) = x64 OR $(var.Platform) = arm64 ?>
  <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
  <?else?>
  <?error "Unsupported platform '$(var.Platform)'. Only x64 and arm64 are supported." ?>
  <?endif?>

  <?define Staging.Dir ="$(var.BuildOutputDir)" ?>
  <?define Staging.Datafile.Dir ="$(var.StagingDatafileDir)" ?>
  <?define WiresharkPlugins.Dir ="$(var.Staging.Dir)\plugins\wireshark" ?>
  <?define WiresharkProfiles.Dir ="$(var.Staging.Datafile.Dir)\profiles" ?>
  <?define WiresharkExtcap.Dir ="$(var.Staging.Dir)\extcap\wireshark" ?>
  <?define WiresharkQt.Dir ="$(var.Staging.Dir)" ?>
  <?define Dtds.Dir ="$(var.Staging.Datafile.Dir)\dtds" ?>
  <?define Tpncp.Dir ="$(var.Staging.Datafile.Dir)\tpncp" ?>
  <?define Trdp.Dir ="$(var.Staging.Datafile.Dir)\trdp" ?>
  <?define Wimaxasncp.Dir ="$(var.Staging.Datafile.Dir)\wimaxasncp" ?>
  <?define Protobuf.Dir ="$(var.Staging.Datafile.Dir)\protobuf" ?>
  <?define Help.Dir ="$(var.Staging.Dir)\help" ?>
  <?define Epan.Lua.Dir ="..\..\epan\wslua" ?>

  <!-- Stratoshark-specific paths -->
  <?define Stratoshark.Plugins.Dir ="$(var.Staging.Dir)\plugins\stratoshark" ?>
  <?define Falco.Plugins.Dir ="$(var.Stratoshark.Plugins.Dir)\falco" ?>
  <?define Stratoshark.Profiles.Dir ="$(var.Staging.Datafile.Dir)\profiles" ?>
  <?define Stratoshark.Extcap.Dir ="$(var.Staging.Dir)\extcap\stratoshark" ?>

</Include>
